# --- App ---
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:4200
TRUST_PROXY=0
SWAGGER_ENABLED=true

# --- Base de datos ---
DATABASE_URL="postgresql://usuario:password@localhost:5432/partly?schema=public"

# --- JWT ---
JWT_ACCESS_SECRET=cambia-este-secreto-de-acceso
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambia-este-secreto-de-refresh
JWT_REFRESH_EXPIRES_IN=30d
PASSWORD_RESET_EXPIRES_IN=30m

# --- Google OAuth ---
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# --- Credenciales de cuentas compartidas (cifrado en reposo) ---
# 32 bytes en hexadecimal (64 caracteres) para AES-256-GCM. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=cambia-esto-por-64-caracteres-hexadecimales-de-32-bytes-aleatorios

# --- Comprobantes de pago (guardados en disco local) ---
RECEIPTS_DIR=uploads/receipts
RECEIPTS_RETENTION_DAYS=30

# --- Correo saliente ---
# log = simulado (por defecto): los correos se guardan en la bandeja de salida y el admin los ve
# en Admin > Correos, pero no salen de verdad. Para activar el envío real elige un proveedor
# (resend | brevo | smtp), llena sus variables y pon MAIL_FROM_ADDRESS con una dirección de tu
# dominio verificado (SPF/DKIM). No hace falta tocar código.
MAIL_PROVIDER=log
MAIL_FROM_NAME=Partly
# MAIL_FROM_ADDRESS=no-reply@tu-dominio.com
# MAIL_REPLY_TO=soporte@tu-dominio.com
# RESEND_API_KEY=re_xxxxxxxx
# BREVO_API_KEY=xkeysib-xxxxxxxx
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario
# SMTP_PASS=contraseña
