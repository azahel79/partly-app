# Dependencias y salidas de compilación
**/node_modules/
**/dist/
**/.angular/
**/coverage/
*.tsbuildinfo

# Configuración local y secretos
**/.env
**/.env.*
!**/.env.example
!.env.production.example

# Datos generados y respaldos sensibles
backend/uploads/
db-backups/
asset-backups/
brand-backups/
*.dump

# Cuentas de prueba locales para las pruebas de extremo a extremo
backend/scripts/qa/qa-users.json

# Llaves privadas y certificados (p. ej. la llave SSH del servidor): nunca al repositorio
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Logs y capturas temporales de QA
*.log
frontend/shot.png
frontend/upload-error.png
frontend/qa/*.png
frontend/qa/*.json
frontend/img-logos/

# Herramientas locales (las skills del proyecto sí se comparten)
.claude/*
!.claude/skills/
.kombai/
.vscode/
.idea/

# Sistema operativo
.DS_Store
Thumbs.db
backend/scripts/qa/.fechas-originales.json
