# Copia este archivo como .env.production y reemplaza TODOS los valores sensibles.
# Nunca agregues .env.production a Git.

NODE_ENV=production
PORT=3000
FRONTEND_URL=https://vakeva.example.com
TRUST_PROXY=1
SWAGGER_ENABLED=false

POSTGRES_DB=vakeva
POSTGRES_USER=vakeva
POSTGRES_PASSWORD=reemplaza-con-una-clave-larga-y-aleatoria
DATABASE_URL=postgresql://vakeva:reemplaza-con-una-clave-larga-y-aleatoria@database:5432/vakeva?schema=public

JWT_ACCESS_SECRET=reemplaza-con-al-menos-32-caracteres-aleatorios
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=reemplaza-con-otro-secreto-de-al-menos-32-caracteres
JWT_REFRESH_EXPIRES_IN=30d
PASSWORD_RESET_EXPIRES_IN=30m

GOOGLE_CLIENT_ID=reemplaza.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=reemplaza-este-secreto
GOOGLE_CALLBACK_URL=https://vakeva.example.com/api/auth/google/callback

# Exactamente 64 caracteres hexadecimales. Perder esta llave impide descifrar credenciales.
CREDENTIALS_ENCRYPTION_KEY=reemplaza_con_64_caracteres_hexadecimales_aleatorios_antes_de_publicar

RECEIPTS_DIR=/app/uploads/receipts
RECEIPTS_RETENTION_DAYS=30

# En producción se exige resend, brevo o smtp; "log" se rechaza al arrancar.
MAIL_PROVIDER=resend
MAIL_FROM_NAME=Vakeva
MAIL_FROM_ADDRESS=no-reply@vakeva.example.com
MAIL_REPLY_TO=soporte@vakeva.example.com
RESEND_API_KEY=reemplaza-esta-clave

HTTP_PORT=8080
